{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../backend && npm ci && npm run build && cd ../frontend && npm ci && npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
