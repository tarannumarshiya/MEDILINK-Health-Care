# MEDILINK frontend environment example.
# Copy to .env.local in the frontend directory and fill in real values.
# These are intentionally PUBLIC (NEXT_PUBLIC_) values. NEVER put service-role
# keys or payment secrets in a frontend environment file.

# Supabase project URL and anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay KEY ID is public and safe to expose to the browser.
# The KEY SECRET must NEVER appear in this file.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# mock | razorpay — keep in sync with backend PAYMENT_MODE
NEXT_PUBLIC_PAYMENTS_MODE=mock

# Express backend URL (kept local during development; points to deployed URL in prod).
EXPRESS_BACKEND_URL=http://localhost:4000
# NEXT_PUBLIC_APP_ENV: development | trial | production
NEXT_PUBLIC_APP_ENV=development